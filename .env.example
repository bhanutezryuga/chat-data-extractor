# Copy this file to ".env" (same folder) and fill in your values.
# The app reads .env automatically on startup. Never commit your real .env.

# From @BotFather in Telegram (required for the Telegram bot; optional otherwise)
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey  (optional — without it, an offline stub runs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Web server (defaults are fine for local use)
HOST=127.0.0.1
PORT=8000

# --- v2 video analysis & usage limits (all optional; sensible defaults shown) ---
ENABLE_VIDEO=1                 # set 0 to keep reels/shorts as NEEDS_REVIEW
MEDIA_RESOLUTION=low           # low|medium|high — low = far fewer tokens for video
MAX_VIDEO_MB=18                # inline upload cap for Instagram/TikTok (needs yt-dlp)
DAILY_TOKEN_BUDGET=1000000     # soft daily cap; video is deferred once exceeded
GEMINI_RPD_LIMIT=250           # requests/day guide (verify at ai.google.dev/gemini-api/docs/rate-limits)
GEMINI_TPM_LIMIT=250000        # tokens/minute guide (display only)

# --- Instagram / TikTok (login-gated; needs yt-dlp). Provide ONE of these. ---
# Recommended on Windows/Chrome: export cookies to a file and point here (see README).
INSTAGRAM_COOKIES=             # e.g. C:\Users\<you>\chat-data-extractor\ig_cookies.txt
# Alternative (often fails on Chrome/Win due to cookie encryption): read live from a browser
COOKIES_FROM_BROWSER=          # chrome | edge | firefox

# --- Actions / intent ---
TRANSLATE_TO=English           # target language for the Translate action

# --- PKM: spaced-repetition "revisit" (resurfaces saved items so they don't rot) ---
REVISIT_ENABLED=1              # set 0 to disable scheduling + reminders entirely
REVISIT_SCHEDULE=1,3,7,16,35   # days between successive revisits (spaced repetition)
REVISIT_SNOOZE_DAYS=1          # how far the "Snooze" button pushes a reminder
REVISIT_CHECK_SECONDS=1800     # how often the scheduler scans for due items
REMIND_CHAT_ID=                # chat to send reminders/digest to (default: the item's origin chat)
REVISIT_MODE=digest           # digest = one weekly review message | peritem = a nudge per item | off
DIGEST_INTERVAL_DAYS=7        # how often the weekly digest is sent (use Telegram /review anytime)
DIGEST_LOOKAHEAD_DAYS=7       # digest includes items due within this many days (plus overdue)

# --- Logseq export (optional): write each capture into a Logseq graph as Markdown ---
LOGSEQ_GRAPH_DIR=              # path to your Logseq graph folder (empty = off), e.g. C:\Users\<you>\logseq-graph
LOGSEQ_ENABLED=1              # set 0 to disable export even if a graph dir is set
LOGSEQ_SYNC_SECONDS=60        # (Phase 2, read-back) how often to poll the graph for user edits

# --- Security (REQUIRED before exposing to the internet) ---
APP_PASSWORD=                  # set a strong password to require login (also unlocks non-localhost binding)
SESSION_SECRET=                # long random string that signs the session cookie (else falls back to APP_PASSWORD)
TELEGRAM_ALLOWED_CHAT_IDS=     # comma-separated chat ids allowed to use the bot (send /start to see yours)
